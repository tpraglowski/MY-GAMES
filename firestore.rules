// My Games — Firestore Security Rules
//
// Not wired to any deploy step (no Firebase CLI project configured here) —
// publishing this means pasting it into Firebase console → Firestore → Rules → Publish.
//
// Every visitor signs in anonymously (signInAnonymously in auth.js) before doing
// anything, so request.auth is never null once the page has loaded. Accounts are our
// own system (Firestore documents in "accounts", not Firebase Auth users), so these
// rules use the uidAccount reverse-lookup pattern (see auth.js's rememberAuthUid) to
// tie a request's anonymous auth UID to the account it actually logged into.
//
// "tpraglowski" is hardcoded as a bootstrap admin (mirrored in auth.js) so the very
// first admin doesn't need another admin to grant it. Every other admin must be
// promoted by an existing admin via the admin panel (admin.html), which flips the
// `admin` field on that account's document.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myAccountId() {
      return get(/databases/$(database)/documents/uidAccount/$(request.auth.uid)).data.accountId;
    }
    function isMe(accountId) {
      return isSignedIn() && exists(/databases/$(database)/documents/uidAccount/$(request.auth.uid)) && myAccountId() == accountId;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/uidAccount/$(request.auth.uid)) &&
        (myAccountId() == 'tpraglowski' || get(/databases/$(database)/documents/accounts/$(myAccountId())).data.get('admin', false) == true);
    }
    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /uidAccount/{uid} {
      // Only the owning device writes its own reverse-lookup entry; nobody needs to
      // read this collection directly (rules read it internally via get()).
      allow read: if false;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /accounts/{accountId} {
      allow read: if isSignedIn();
      // Registration: anyone signed in (anonymously) may create their own account,
      // but cannot hand themselves admin on the way in.
      allow create: if isSignedIn() && request.resource.data.get('admin', false) != true;
      // Update: either it's your own account or you're an admin — and only an admin
      // may change the `admin` field itself.
      // Only admins may change `admin`, `verified` (in the score table) and `displayName`
      // (the nick shown there).
      allow update: if isSignedIn() && (isMe(accountId) || isAdmin())
        && (isAdmin() || !changedFields().hasAny(['admin', 'verified', 'displayName']));
      allow delete: if isAdmin();
    }

    // Player messages shown under a game. Anyone signed in may send one (as themselves
    // or as "gość"), but only admins can read them, mark them read or delete them.
    match /messages/{messageId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['gameId', 'gameTitle', 'text', 'from', 'read', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.read == false
        && (request.resource.data.from == 'gość' || isMe(request.resource.data.from.lower()));
      allow read: if isAdmin();
      allow update: if isAdmin() && changedFields().hasOnly(['read', 'readBy', 'readAt']);
      allow delete: if isAdmin();
    }

    // Score table data. The game reports a logged-in player's stats (document id is
    // <gameId>_<account>), and only that player can write their own entry. Whether it is
    // shown, and under which nick, is decided by the admin via the account's
    // `verified` / `displayName` fields.
    match /scores/{scoreId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isMe(request.resource.data.account)
        && request.resource.data.keys().hasOnly(['gameId', 'account', 'coins', 'gems', 'playTime', 'updatedAt'])
        && request.resource.data.coins is number && request.resource.data.gems is number && request.resource.data.playTime is number
        && scoreId == request.resource.data.gameId + '_' + request.resource.data.account;
      allow delete: if isAdmin();
    }

    match /games/{gameId} {
      allow read: if isSignedIn();
      // A game can only be created with addedBy set to the account actually making
      // the request — the app can't spoof "posted by someone else" server-side.
      // addedBy is stored with whatever casing the user originally registered with
      // (for display), while myAccountId() is always lowercase (it's the accounts
      // doc id) — .lower() both sides so e.g. "Tomek" still matches "tomek".
      allow create: if isSignedIn() && request.resource.data.addedBy.lower() == myAccountId();
      // The uploader can edit/delete their own game; an admin can edit or delete any
      // game (e.g. to fix up a category the original uploader left as "inne").
      allow update: if isMe(resource.data.addedBy.lower()) || isAdmin();
      allow delete: if isMe(resource.data.addedBy.lower()) || isAdmin();
    }
  }
}
